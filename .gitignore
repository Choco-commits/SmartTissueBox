# =====================================================================
#  Keil MDK-ARM (STM32F103) 工程 .gitignore
# =====================================================================

# ---- Keil 编译/链接中间产物与输出文件 --------------------------------
*.o
*.obj
*.d
*.crf
*.lst
*.map
*.htm
*.lnp
*.sct
*.dep
*.iex
*.i
*.build_log.htm

# 可执行 / 烧录文件（由源码可重新生成；如需方便烧录可自行保留 .hex）
*.axf
*.elf
*.bin
*.hex

# ---- Keil 生成目录 ---------------------------------------------------
MDK-ARM/RTE/
MDK-ARM/DebugConfig/
MDK-ARM/TissueLevelDetection/

# ---- Keil 用户个人配置（.uvprojx 工程文件会保留提交）------------------
*.uvoptx
*.uvguix
*.uvguix.*

# ---- CubeMX 自动生成元数据（.ioc 工程源文件保留提交）-----------------
.mxproject

# ---- Claude Code 本地配置 -------------------------------------------
.claude/

# ---- 本地备份 / 测试 / 参考工程（不提交）-----------------------------
backup/
ServoControl/

# ---- 系统垃圾文件 -----------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
